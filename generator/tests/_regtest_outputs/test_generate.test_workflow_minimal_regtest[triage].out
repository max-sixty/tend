# Generated by tend X.Y.Z. Regenerate with: uvx tend@latest init
#
# Do not edit this file directly ? it will be overwritten on regeneration.
# To change this workflow, edit .config/tend.yaml. To change what the agent
# does, edit the relevant skill (for example, `running-tend`) in this repo's
# .claude/skills/ directory, or open an issue at
# https://github.com/max-sixty/tend/issues for changes that need to
# happen upstream in the tend-ci-runner plugin.

name: tend-triage
# A dispatched run would otherwise be named for the workflow. Named for the
# issue, like an opened one, the notifications poll can see it holds that
# issue.
run-name: ${{ inputs.title || github.event.issue.title }}
on:
  issues:
    types: [opened, reopened]
  # An issue a later run hands back, such as a stalled CI report or cause.
  workflow_dispatch:
    inputs:
      issue:
        description: The issue to triage
        type: number
        required: true
      title:
        description: The issue's title, which names the run
        type: string
        default: ""

jobs:
  enqueue:
    if: vars.TEND_ENABLED != 'false' && contains(github.event.issue.labels.*.name, 'tend-outage') == false && contains(github.event.issue.labels.*.name, 'tend-rate-limit') == false
    runs-on: ubuntu-24.04
    environment:
      name: tend
      deployment: false
    permissions: {}
    outputs:
      ready: ${{ steps.queue.outputs.ready }}
    steps:
      - name: Record pending triage before admission
        id: queue
        env:
          GH_TOKEN: ${{ secrets.TEND_BOT_TOKEN }}
          ISSUE_NUMBER: ${{ github.event.issue.number || inputs.issue }}
          QUEUE_ACTION: enqueue
        run: |
          python3 -I - <<'TEND_PY'
          # /// script
          # requires-python = ">=3.12"
          # dependencies = []
          # ///
          """Keep unfinished issue triage durable outside GitHub's bounded run queue.

          Enqueue an open issue before its agent job queues. Remove the pending label
          only after a successful agent turn; failed or cancelled runs leave it for
          recovery. Inputs: GH_TOKEN, GITHUB_REPOSITORY, ISSUE_NUMBER, QUEUE_ACTION
          (enqueue, admit or complete), GITHUB_OUTPUT, and optionally GITHUB_API_URL.
          Enqueue records work; admit only accepts work still pending. Both output ready
          and generation (the latest reopen event ID, or zero). Complete
          takes that admitted generation as QUEUE_GENERATION and preserves newer work.
          """

          from __future__ import annotations

          import json
          import os
          from pathlib import Path
          from urllib.error import HTTPError
          from urllib.request import Request, urlopen

          LABEL = "tend-triage-pending"


          def api(path: str, *, method: str = "GET", body: dict | None = None):
              request = Request(
                  f"{os.environ.get('GITHUB_API_URL', 'https://api.github.com')}/{path}",
                  data=json.dumps(body).encode() if body is not None else None,
                  method=method,
                  headers={
                      "Authorization": f"Bearer {os.environ['GH_TOKEN']}",
                      "Accept": "application/vnd.github+json",
                      "Content-Type": "application/json",
                  },
              )
              with urlopen(request, timeout=30) as response:
                  payload = response.read()
              return json.loads(payload) if payload else None


          def ensure_label(repo: str) -> None:
              path = f"repos/{repo}/labels/{LABEL}"
              try:
                  api(path)
                  return
              except HTTPError as error:
                  if error.code != 404:
                      raise
              try:
                  api(
                      f"repos/{repo}/labels",
                      method="POST",
                      body={
                          "name": LABEL,
                          "color": "ededed",
                          "description": "Tend issue triage has not completed successfully",
                      },
                  )
              except HTTPError as error:
                  if error.code != 422:
                      raise
                  # Another enqueue may have created the label since our GET.
                  api(path)


          def generation(path: str) -> int:
              """A reopen creates new work even while an earlier triage is finishing."""
              latest = 0
              page = 1
              while True:
                  events = api(f"{path}/events?per_page=100&page={page}")
                  latest = max(
                      latest,
                      max(
                          (event["id"] for event in events if event["event"] == "reopened"),
                          default=0,
                      ),
                  )
                  if len(events) < 100:
                      return latest
                  page += 1


          def main() -> int:
              repo = os.environ["GITHUB_REPOSITORY"]
              number = int(os.environ["ISSUE_NUMBER"])
              if number <= 0:
                  raise ValueError("ISSUE_NUMBER must be a positive issue number")
              path = f"repos/{repo}/issues/{number}"
              action = os.environ["QUEUE_ACTION"]
              if action == "complete":
                  admitted = int(os.environ["QUEUE_GENERATION"])
                  if generation(path) != admitted:
                      return 0
                  try:
                      api(f"{path}/labels/{LABEL}", method="DELETE")
                  except HTTPError as error:
                      if error.code != 404:
                          raise
                  # GitHub has no conditional label deletion. Restore a reopen that
                  # raced the delete; a later reopen's own enqueue adds the label.
                  if generation(path) != admitted:
                      api(f"{path}/labels", method="POST", body={"labels": [LABEL]})
              elif action in ("enqueue", "admit"):
                  issue = api(path)
                  if "pull_request" in issue:
                      raise ValueError("Issue triage cannot enqueue a pull request")
                  pending = any(label["name"] == LABEL for label in issue["labels"])
                  ready = issue["state"] == "open" and (action == "enqueue" or pending)
                  admitted = generation(path) if ready else 0
                  if ready and not pending:
                      ensure_label(repo)
                      api(f"{path}/labels", method="POST", body={"labels": [LABEL]})
                  with Path(os.environ["GITHUB_OUTPUT"]).open("a") as output:
                      output.write(f"ready={str(ready).lower()}\n")
                      output.write(f"generation={admitted}\n")
              else:
                  raise ValueError(f"Unknown QUEUE_ACTION: {action}")
              return 0


          if __name__ == "__main__":
              raise SystemExit(main())
          TEND_PY

  triage:
    needs: enqueue
    if: vars.TEND_ENABLED != 'false' && needs.enqueue.outputs.ready == 'true'
    # One issue worker at a time, including report diagnosis and recovery.
    # The issue's pending label survives failure or GitHub's finite queue.
    concurrency:
      group: tend-triage
      cancel-in-progress: false
      queue: max
    runs-on: ubuntu-24.04
    environment:
      name: tend
      deployment: false
    permissions:
      contents: write
      pull-requests: write
      actions: read
      issues: write
    steps:
      - name: Recheck live issue after admission
        id: admit
        env:
          GH_TOKEN: ${{ secrets.TEND_BOT_TOKEN }}
          ISSUE_NUMBER: ${{ github.event.issue.number || inputs.issue }}
          QUEUE_ACTION: admit
        run: |
          python3 -I - <<'TEND_PY'
          # /// script
          # requires-python = ">=3.12"
          # dependencies = []
          # ///
          """Keep unfinished issue triage durable outside GitHub's bounded run queue.

          Enqueue an open issue before its agent job queues. Remove the pending label
          only after a successful agent turn; failed or cancelled runs leave it for
          recovery. Inputs: GH_TOKEN, GITHUB_REPOSITORY, ISSUE_NUMBER, QUEUE_ACTION
          (enqueue, admit or complete), GITHUB_OUTPUT, and optionally GITHUB_API_URL.
          Enqueue records work; admit only accepts work still pending. Both output ready
          and generation (the latest reopen event ID, or zero). Complete
          takes that admitted generation as QUEUE_GENERATION and preserves newer work.
          """

          from __future__ import annotations

          import json
          import os
          from pathlib import Path
          from urllib.error import HTTPError
          from urllib.request import Request, urlopen

          LABEL = "tend-triage-pending"


          def api(path: str, *, method: str = "GET", body: dict | None = None):
              request = Request(
                  f"{os.environ.get('GITHUB_API_URL', 'https://api.github.com')}/{path}",
                  data=json.dumps(body).encode() if body is not None else None,
                  method=method,
                  headers={
                      "Authorization": f"Bearer {os.environ['GH_TOKEN']}",
                      "Accept": "application/vnd.github+json",
                      "Content-Type": "application/json",
                  },
              )
              with urlopen(request, timeout=30) as response:
                  payload = response.read()
              return json.loads(payload) if payload else None


          def ensure_label(repo: str) -> None:
              path = f"repos/{repo}/labels/{LABEL}"
              try:
                  api(path)
                  return
              except HTTPError as error:
                  if error.code != 404:
                      raise
              try:
                  api(
                      f"repos/{repo}/labels",
                      method="POST",
                      body={
                          "name": LABEL,
                          "color": "ededed",
                          "description": "Tend issue triage has not completed successfully",
                      },
                  )
              except HTTPError as error:
                  if error.code != 422:
                      raise
                  # Another enqueue may have created the label since our GET.
                  api(path)


          def generation(path: str) -> int:
              """A reopen creates new work even while an earlier triage is finishing."""
              latest = 0
              page = 1
              while True:
                  events = api(f"{path}/events?per_page=100&page={page}")
                  latest = max(
                      latest,
                      max(
                          (event["id"] for event in events if event["event"] == "reopened"),
                          default=0,
                      ),
                  )
                  if len(events) < 100:
                      return latest
                  page += 1


          def main() -> int:
              repo = os.environ["GITHUB_REPOSITORY"]
              number = int(os.environ["ISSUE_NUMBER"])
              if number <= 0:
                  raise ValueError("ISSUE_NUMBER must be a positive issue number")
              path = f"repos/{repo}/issues/{number}"
              action = os.environ["QUEUE_ACTION"]
              if action == "complete":
                  admitted = int(os.environ["QUEUE_GENERATION"])
                  if generation(path) != admitted:
                      return 0
                  try:
                      api(f"{path}/labels/{LABEL}", method="DELETE")
                  except HTTPError as error:
                      if error.code != 404:
                          raise
                  # GitHub has no conditional label deletion. Restore a reopen that
                  # raced the delete; a later reopen's own enqueue adds the label.
                  if generation(path) != admitted:
                      api(f"{path}/labels", method="POST", body={"labels": [LABEL]})
              elif action in ("enqueue", "admit"):
                  issue = api(path)
                  if "pull_request" in issue:
                      raise ValueError("Issue triage cannot enqueue a pull request")
                  pending = any(label["name"] == LABEL for label in issue["labels"])
                  ready = issue["state"] == "open" and (action == "enqueue" or pending)
                  admitted = generation(path) if ready else 0
                  if ready and not pending:
                      ensure_label(repo)
                      api(f"{path}/labels", method="POST", body={"labels": [LABEL]})
                  with Path(os.environ["GITHUB_OUTPUT"]).open("a") as output:
                      output.write(f"ready={str(ready).lower()}\n")
                      output.write(f"generation={admitted}\n")
              else:
                  raise ValueError(f"Unknown QUEUE_ACTION: {action}")
              return 0


          if __name__ == "__main__":
              raise SystemExit(main())
          TEND_PY

      - name: React with eyes
        if: steps.admit.outputs.ready == 'true'
        run: |
          gh api "repos/$REPO/$TARGET/reactions" -f content=eyes --silent \
            || echo "::warning::could not add the eyes reaction"
        env:
          REPO: ${{ github.repository }}
          TARGET: issues/${{ github.event.issue.number || inputs.issue }}
          GITHUB_TOKEN: ${{ secrets.TEND_BOT_TOKEN }}

      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        if: steps.admit.outputs.ready == 'true'
        with:
          ref: main
          fetch-depth: 0
          token: ${{ secrets.TEND_BOT_TOKEN }}

      - uses: max-sixty/tend/claude@X.Y.Z
        if: steps.admit.outputs.ready == 'true'
        with:
          github_token: ${{ secrets.TEND_BOT_TOKEN }}
          merge: restricted
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          bot_name: test-bot
          model: opus
          checkout_mode: base
          base_branch: ${{ github.event.repository.default_branch }}
          prompt: |2
            /tend-ci-runner:triage ${{ github.event.issue.number || inputs.issue }}

      - name: Complete pending triage
        if: success() && steps.admit.outputs.ready == 'true'
        env:
          GH_TOKEN: ${{ secrets.TEND_BOT_TOKEN }}
          ISSUE_NUMBER: ${{ github.event.issue.number || inputs.issue }}
          QUEUE_ACTION: complete
          QUEUE_GENERATION: ${{ steps.admit.outputs.generation }}
        run: |
          python3 -I - <<'TEND_PY'
          # /// script
          # requires-python = ">=3.12"
          # dependencies = []
          # ///
          """Keep unfinished issue triage durable outside GitHub's bounded run queue.

          Enqueue an open issue before its agent job queues. Remove the pending label
          only after a successful agent turn; failed or cancelled runs leave it for
          recovery. Inputs: GH_TOKEN, GITHUB_REPOSITORY, ISSUE_NUMBER, QUEUE_ACTION
          (enqueue, admit or complete), GITHUB_OUTPUT, and optionally GITHUB_API_URL.
          Enqueue records work; admit only accepts work still pending. Both output ready
          and generation (the latest reopen event ID, or zero). Complete
          takes that admitted generation as QUEUE_GENERATION and preserves newer work.
          """

          from __future__ import annotations

          import json
          import os
          from pathlib import Path
          from urllib.error import HTTPError
          from urllib.request import Request, urlopen

          LABEL = "tend-triage-pending"


          def api(path: str, *, method: str = "GET", body: dict | None = None):
              request = Request(
                  f"{os.environ.get('GITHUB_API_URL', 'https://api.github.com')}/{path}",
                  data=json.dumps(body).encode() if body is not None else None,
                  method=method,
                  headers={
                      "Authorization": f"Bearer {os.environ['GH_TOKEN']}",
                      "Accept": "application/vnd.github+json",
                      "Content-Type": "application/json",
                  },
              )
              with urlopen(request, timeout=30) as response:
                  payload = response.read()
              return json.loads(payload) if payload else None


          def ensure_label(repo: str) -> None:
              path = f"repos/{repo}/labels/{LABEL}"
              try:
                  api(path)
                  return
              except HTTPError as error:
                  if error.code != 404:
                      raise
              try:
                  api(
                      f"repos/{repo}/labels",
                      method="POST",
                      body={
                          "name": LABEL,
                          "color": "ededed",
                          "description": "Tend issue triage has not completed successfully",
                      },
                  )
              except HTTPError as error:
                  if error.code != 422:
                      raise
                  # Another enqueue may have created the label since our GET.
                  api(path)


          def generation(path: str) -> int:
              """A reopen creates new work even while an earlier triage is finishing."""
              latest = 0
              page = 1
              while True:
                  events = api(f"{path}/events?per_page=100&page={page}")
                  latest = max(
                      latest,
                      max(
                          (event["id"] for event in events if event["event"] == "reopened"),
                          default=0,
                      ),
                  )
                  if len(events) < 100:
                      return latest
                  page += 1


          def main() -> int:
              repo = os.environ["GITHUB_REPOSITORY"]
              number = int(os.environ["ISSUE_NUMBER"])
              if number <= 0:
                  raise ValueError("ISSUE_NUMBER must be a positive issue number")
              path = f"repos/{repo}/issues/{number}"
              action = os.environ["QUEUE_ACTION"]
              if action == "complete":
                  admitted = int(os.environ["QUEUE_GENERATION"])
                  if generation(path) != admitted:
                      return 0
                  try:
                      api(f"{path}/labels/{LABEL}", method="DELETE")
                  except HTTPError as error:
                      if error.code != 404:
                          raise
                  # GitHub has no conditional label deletion. Restore a reopen that
                  # raced the delete; a later reopen's own enqueue adds the label.
                  if generation(path) != admitted:
                      api(f"{path}/labels", method="POST", body={"labels": [LABEL]})
              elif action in ("enqueue", "admit"):
                  issue = api(path)
                  if "pull_request" in issue:
                      raise ValueError("Issue triage cannot enqueue a pull request")
                  pending = any(label["name"] == LABEL for label in issue["labels"])
                  ready = issue["state"] == "open" and (action == "enqueue" or pending)
                  admitted = generation(path) if ready else 0
                  if ready and not pending:
                      ensure_label(repo)
                      api(f"{path}/labels", method="POST", body={"labels": [LABEL]})
                  with Path(os.environ["GITHUB_OUTPUT"]).open("a") as output:
                      output.write(f"ready={str(ready).lower()}\n")
                      output.write(f"generation={admitted}\n")
              else:
                  raise ValueError(f"Unknown QUEUE_ACTION: {action}")
              return 0


          if __name__ == "__main__":
              raise SystemExit(main())
          TEND_PY

      - name: Remove the eyes reaction
        if: always() && steps.admit.outputs.ready == 'true'
        run: |
          REACTION_ID=$(gh api --paginate \
            "repos/$REPO/$TARGET/reactions?content=eyes&per_page=100" \
            --jq ".[] | select(.user.login == \"$BOT_NAME\") | .id" | head -n1)
          if [ -n "$REACTION_ID" ]; then
            gh api -X DELETE "repos/$REPO/$TARGET/reactions/$REACTION_ID" --silent \
              || echo "::warning::could not remove the eyes reaction"
          fi
        env:
          REPO: ${{ github.repository }}
          TARGET: issues/${{ github.event.issue.number || inputs.issue }}
          BOT_NAME: test-bot
          GITHUB_TOKEN: ${{ secrets.TEND_BOT_TOKEN }}
