# Generated by tend X.Y.Z. Regenerate with: uvx tend@latest init
#
# Do not edit this file directly ? it will be overwritten on regeneration.
# To change this workflow, edit .config/tend.yaml. To change what the agent
# does, edit the relevant skill (for example, `running-tend`) in this repo's
# .claude/skills/ directory, or open an issue at
# https://github.com/max-sixty/tend/issues for changes that need to
# happen upstream in the tend-ci-runner plugin.

name: tend-install-test
on:
  pull_request:
    paths:
      - .github/workflows/tend-*.yaml
      - .github/CODEOWNERS
      - CODEOWNERS
      - docs/CODEOWNERS
      - .config/tend.yaml

jobs:
  install-test:
    # Same-repo PRs only. Fork PRs are out of scope and the workflow
    # is short-lived (removed on the next nightly regen), so cross-fork
    # validation isn't worth special-casing.
    if: github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-24.04
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v7
      - uses: astral-sh/setup-uv@v10.2.0
        id: tend_uv
        env:
          UV_NO_MODIFY_PATH: "1"
        with:
          version: "0.12.17"
          enable-cache: false
          ignore-empty-workdir: true
      - name: Verify generator output matches committed files
        env:
          GH_TOKEN: ${{ github.token }}
          TEND_UVX: ${{ steps.tend_uv.outputs.uvx-path }}
        run: |
          # `actions/checkout` only fetches the PR head ref, so the
          # generator's default-branch probe (`git rev-parse --abbrev-ref
          # origin/HEAD`) falls back to "main" and a repo with a non-`main`
          # default reports spurious drift. Resolve the default branch via
          # the API, fetch it, then point `origin/HEAD` at it.
          DEFAULT_BRANCH=$(gh api "repos/$GITHUB_REPOSITORY" --jq .default_branch)
          git fetch origin --depth 1 "+refs/heads/$DEFAULT_BRANCH:refs/remotes/origin/$DEFAULT_BRANCH"
          git symbolic-ref "refs/remotes/origin/HEAD" "refs/remotes/origin/$DEFAULT_BRANCH"
          # Pin the regen to the version in the committed header so a tend
          # release between local `init` and this CI run doesn't fail the
          # drift check for an irrelevant reason.
          HEADER=$(head -1 .github/workflows/tend-install-test.yaml)
          HEADER="${HEADER#'# Generated by tend '}"
          TEND_VERSION="${HEADER%%'. Regenerate'*}"
          "$TEND_UVX" "tend@$TEND_VERSION" init --with-install-test
          # `git diff` alone ignores untracked files, so generator output the
          # PR never committed would pass green: a workflow the regen newly
          # emits, or the `.github/actionlint.yaml` ignore. The intent-to-add
          # brings those into the diff and stages the removal of anything the
          # regen deleted, so compare against HEAD to catch both directions.
          # Include either consumer-owned CODEOWNERS location: yolo `init`
          # updates whichever one is effective. The job never commits.
          git add --intent-to-add .github .config
          for path in CODEOWNERS docs/CODEOWNERS; do
            if [ -e "$path" ] || [ -L "$path" ]; then
              git add --intent-to-add "$path"
            fi
          done
          if ! git diff HEAD --quiet -- .github .config CODEOWNERS docs/CODEOWNERS; then
            echo "::error::Committed files differ from 'uvx tend@$TEND_VERSION init --with-install-test' output. Run it locally and commit the result."
            git --no-pager diff HEAD -- .github .config CODEOWNERS docs/CODEOWNERS
            exit 1
          fi
