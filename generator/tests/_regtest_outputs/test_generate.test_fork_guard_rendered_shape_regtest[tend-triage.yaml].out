# Generated by tend X.Y.Z. Regenerate with: uvx tend@latest init
#
# Do not edit this file directly ? it will be overwritten on regeneration.
# To change this workflow, edit .config/tend.yaml. To change what the agent
# does, edit the relevant skill (for example, `running-tend`) in this repo's
# .claude/skills/ directory, or open an issue at
# https://github.com/max-sixty/tend/issues for changes that need to
# happen upstream in the tend-ci-runner plugin.

name: tend-triage
# Keep the selected IDs visible before matrix jobs exist.
run-name: triage ${{ inputs.issues || format('[{0}]', github.event.issue.number) }}
on:
  issues:
    types: [opened, reopened]
  workflow_dispatch:
    inputs:
      issues:
        description: JSON array of issue numbers; use the triage-batch dispatch command to split large selections
        type: string
        required: true

jobs:
  select:
    if: github.repository_owner == 'test-owner' && vars.TEND_ENABLED != 'false' && contains(github.event.issue.labels.*.name, 'tend-outage') == false && contains(github.event.issue.labels.*.name, 'tend-rate-limit') == false
    runs-on: ubuntu-24.04
    permissions:
      contents: read
    outputs:
      legs: ${{ steps.select.outputs.legs }}
    steps:
      - uses: max-sixty/tend/setup-runtime@X.Y.Z
      - name: Route issues to lanes
        id: select
        env:
          ISSUES: ${{ inputs.issues || format('[{0}]', github.event.issue.number) }}
          LANES: 5
        run: |
          tend runtime triage-batch select

  triage:
    needs: select
    if: needs.select.outputs.legs != '[]'
    name: "triage #${{ matrix.issue }}"
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(needs.select.outputs.legs) }}
    # Each issue job waits in lane `issue % 5`, which runs one job at a
    # time, so at most 5 sessions run at once across event runs and
    # dispatched batches. An issue always takes the same lane, so two runs for
    # one issue never overlap. Lanes are fixed by issue number, so two issues in
    # one lane wait for each other even while another lane is idle. GitHub
    # cancels a job beyond a lane's 100 pending ones; its open issue stays for
    # the daily sweep.
    concurrency:
      group: tend-triage-${{ matrix.lane }}
      cancel-in-progress: false
      queue: max
    runs-on: ubuntu-24.04
    environment:
      name: tend
      deployment: false
    permissions:
      contents: write
      pull-requests: write
      actions: read
      issues: write
    env:
      TEND_ISSUE_NUMBER: ${{ matrix.issue }}
    steps:
      - uses: max-sixty/tend/setup-runtime@X.Y.Z
      # The job may have waited hours for its lane. An issue closed meanwhile,
      # a pull request or a bookkeeping issue ends it before setup and the agent.
      - name: Check the issue is still open triage work
        id: eligible
        env:
          GITHUB_TOKEN: ${{ secrets.TEND_BOT_TOKEN }}
          BOOKKEEPING_LABELS: '["tend-outage", "tend-rate-limit"]'
        run: |
          tend runtime triage-batch eligible
      - name: React with eyes
        if: steps.eligible.outputs.eligible == 'true'
        run: |
          tend runtime reaction add
        env:
          REPO: ${{ github.repository }}
          TARGET: issues/${{ matrix.issue }}
          GITHUB_TOKEN: ${{ secrets.TEND_BOT_TOKEN }}

      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        if: steps.eligible.outputs.eligible == 'true'
        with:
          ref: main
          fetch-depth: 0
          token: ${{ secrets.TEND_BOT_TOKEN }}

      - uses: max-sixty/tend/claude@X.Y.Z
        if: steps.eligible.outputs.eligible == 'true'
        with:
          github_token: ${{ secrets.TEND_BOT_TOKEN }}
          merge: restricted
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          model: opus
          checkout_mode: base
          base_branch: ${{ github.event.repository.default_branch }}
          prompt: |2
            /tend-ci-runner:triage ${{ matrix.issue }}

      - name: Remove the eyes reaction
        if: always() && steps.eligible.outputs.eligible == 'true'
        run: |
          tend runtime reaction remove
        env:
          REPO: ${{ github.repository }}
          TARGET: issues/${{ matrix.issue }}
          BOT_NAME: test-bot
          GITHUB_TOKEN: ${{ secrets.TEND_BOT_TOKEN }}
