<<header>>
name: tend-ci-failures
# Turns a watched workflow's verdict on a watched branch into its CI failure
# report, with no agent: a failure files the report or comments on it, and a
# pass closes it. `ci_failure_report.py` documents the report, and why it
# writes with the job's own token rather than the bot's.
on:
  workflow_run:
    workflows: <<watched|tojson>>
    types: [completed]
    branches: <<branches|tojson>>

jobs:
  report:
    # Only a verdict reaches the group below. On a busy branch most completions
    # are runs a newer commit cancelled, and each would otherwise take the
    # lane's single pending slot from a verdict waiting in it.
    if: >-
      <<fork_guard_prefix(cfg)>><<tend_enabled>> && (
        github.event.workflow_run.conclusion == 'success'
        || github.event.workflow_run.conclusion == 'failure'
        || github.event.workflow_run.conclusion == 'timed_out'
        || github.event.workflow_run.conclusion == 'startup_failure')
    concurrency:
      # One writer per report, so one lane's verdicts apply in turn and never
      # file two reports. A newer pending verdict replaces an older one, which
      # it supersedes anyway.
      group: ${{ github.workflow }}-${{ github.event.workflow_run.name }}-${{ github.event.workflow_run.event }}-${{ github.event.workflow_run.head_branch }}
      cancel-in-progress: false
    runs-on: ubuntu-24.04
    permissions:
      actions: read
      issues: write
    steps:
<<setup_tend_uv()>>
      - name: File, update or close the CI failure report
        env:
          GH_TOKEN: ${{ github.token }}
          BOT_NAME: <<cfg.bot_name>>
          TEND_UV: ${{ steps.tend_uv.outputs.uv-path }}
        run: |
          "$TEND_UV" run --script - <<heredoc>>'TEND_PY'
<<report_script|indent(10, first=True)>>
          TEND_PY
