{#- The failing run's coordinates, appended to whatever prompt is configured.
    `block_input` indents the whole thing, so the prompt may span lines. #}
{%- set full_prompt %}<<prompt>>
- Run URL: ${{ github.event.workflow_run.html_url }}
- Commit: ${{ github.event.workflow_run.head_sha }}
- Commit message: ${{ github.event.workflow_run.head_commit.message }}{% endset -%}
<<header>>
name: tend-ci-fix
on:
  workflow_run:
    workflows: <<watched|tojson>>
    types: [completed]
    branches: <<branches|tojson>>

jobs:
  fix-ci:
    # By default, only failed runs start a ci-fix session.
    if: <<fork_guard_prefix(cfg)>><<tend_enabled>> && github.event.workflow_run.conclusion == 'failure'
    concurrency:
      # A red branch fails every push that follows, each on its own commit, so
      # one session per branch — not per commit — is what collapses the burst.
      # The watched workflow and the run's event are in the key too: a red
      # `publish-site` must not starve behind a stream of red `ci`, and a
      # pending scheduled failure must not be replaced by the next push
      # failure on the same branch. Never cancel — a running session may
      # already have pushed a branch or opened a PR. Default queue depth is
      # right: within each group, the newest failure replaces the pending one.
      group: ${{ github.workflow }}-${{ github.event.workflow_run.name }}-${{ github.event.workflow_run.event }}-${{ github.event.workflow_run.head_branch }}
      cancel-in-progress: false
    runs-on: ubuntu-24.04
<<environment()>>
    permissions:
<<permissions(issues=False)>>
    steps:
<<checkout(cfg, ref=cfg.default_branch)>>
<<setup>>
<<agent_step(cfg, block_input('prompt', full_prompt))>>
