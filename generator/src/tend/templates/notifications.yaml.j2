<<header>>
name: tend-notifications
on:
  schedule:
    - cron: "<<cron>>"
  workflow_dispatch:

jobs:
  notifications:
    concurrency:
      group: tend-notifications
      cancel-in-progress: false
    if: <<fork_guard_prefix(cfg)>><<tend_enabled>>
    runs-on: ubuntu-24.04
<<environment()>>
    permissions:
<<permissions()>>
    steps:
<<setup_tend_runtime()>>
      - name: Check notifications and conflicts
        id: check
        env:
          GITHUB_TOKEN: ${{ secrets.<<bot_token_secret>> }}
        run: |
          tend runtime notifications-check

<<checkout(cfg, ref=cfg.default_branch, if_condition=skip_condition)>>
<<setup>><<agent_step(cfg, block_input('prompt', prompt), if_condition=skip_condition)>>
