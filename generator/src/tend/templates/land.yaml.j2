<<header>>
name: tend-land
# Lands a reviewed PR once its CI completes, with no session waiting for it.
# With the review's CI wait off, a review that settles everything about a head
# the bot pushed but its CI records the head for landing (a `tend/land/<PR>`
# commit status naming the base and any skipped checks) and ends. Each
# completion of a watched CI workflow runs `check`, Tend's pinned script with
# no agent and no checkout of the PR, which decides only what is crisp: a
# record for that head and base, and every check finished. Green with a record
# starts a short `land` session that makes the landing decision; a red on a PR
# with no human author starts `repair`. `land_pr.py` documents the records.
on:
  workflow_run:
    workflows: <<watched|tojson>>
    types: [completed]

jobs:
  check:
    # A run on this repository's default branch has no PR to land. The repo is
    # part of that test: a fork's PR from its own `main` carries the same
    # branch name.
    if: <<fork_guard_prefix(cfg)>><<tend_enabled>> && !(github.event.workflow_run.head_repository.full_name == github.repository && github.event.workflow_run.head_branch == github.event.repository.default_branch)
    runs-on: ubuntu-24.04
<<environment()>>
    permissions:
      contents: read
    outputs:
      land_pr: ${{ steps.check.outputs.land_pr }}
      red_pr: ${{ steps.check.outputs.red_pr }}
    steps:
      - uses: max-sixty/tend/land@<<tend_version>>
        id: check
        with:
          github_token: ${{ secrets.<<bot_token_secret>> }}
          head_sha: ${{ github.event.workflow_run.head_sha }}
          conclusion: ${{ github.event.workflow_run.conclusion }}

  # Each watched workflow's completion arrives separately, so both sessions
  # queue per PR and never cancel: the second reads what the first did.
  land:
    needs: check
    if: needs.check.outputs.land_pr != ''
    concurrency:
      group: ${{ github.workflow }}-${{ needs.check.outputs.land_pr }}
      cancel-in-progress: false
    runs-on: ubuntu-24.04
<<environment()>>
    permissions:
<<permissions()>>
    steps:
<<checkout(cfg, ref=cfg.default_branch)>>
<<agent_step(cfg, block_input('prompt', land_prompt))>>

  # A PR with no human author went red after its review ended, so no session
  # is waiting to repair it; this one continues it, as the review would have.
  repair:
    needs: check
    if: needs.check.outputs.red_pr != ''
    concurrency:
      group: ${{ github.workflow }}-${{ needs.check.outputs.red_pr }}
      cancel-in-progress: false
    runs-on: ubuntu-24.04
<<environment()>>
    permissions:
<<permissions()>>
    steps:
<<checkout(cfg, ref=cfg.default_branch)>>
<<setup>>
<<agent_step(cfg, block_input('prompt', repair_prompt))>>
