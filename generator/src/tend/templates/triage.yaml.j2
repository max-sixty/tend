{%- set issue = '${{ matrix.issue }}' -%}
<<header>>
name: tend-triage
# Keep the selected IDs visible before matrix jobs exist, including while queued.
run-name: triage ${{ inputs.issues || format('[{0}]', github.event.issue.number) }}
on:
  issues:
    types: [opened, reopened]
  workflow_dispatch:
    inputs:
      issues:
        description: JSON array of issue numbers, up to 256
        type: string
        required: true

# The whole batch holds the lane: overlapping events cannot multiply the cap.
concurrency:
  group: tend-triage
  cancel-in-progress: false
  queue: max

jobs:
  select:
    if: <<fork_guard_prefix(cfg)>><<tend_enabled>> && <<not_bookkeeping()>>
    runs-on: ubuntu-24.04
<<environment()>>
    permissions:
      contents: read
    outputs:
      issues: ${{ steps.select.outputs.issues }}
    steps:
<<setup_tend_uv()>>
      - name: Select current issues
        id: select
        env:
          GITHUB_TOKEN: ${{ secrets.<<bot_token_secret>> }}
          ISSUES: ${{ inputs.issues || format('[{0}]', github.event.issue.number) }}
          BOOKKEEPING_LABELS: '<<bookkeeping_labels|tojson>>'
          TEND_UV: ${{ steps.tend_uv.outputs.uv-path }}
        run: |
          "$TEND_UV" run --script - <<heredoc>>'TEND_PY'
<<select_script|indent(10, first=True)>>
          TEND_PY

  triage:
    needs: select
    if: needs.select.outputs.issues != '[]'
    name: "triage #${{ matrix.issue }}"
    strategy:
      fail-fast: false
      max-parallel: <<max_parallel>>
      matrix:
        issue: ${{ fromJSON(needs.select.outputs.issues) }}
    runs-on: ubuntu-24.04
<<environment()>>
    permissions:
<<permissions()>>
    env:
      TEND_ISSUE_NUMBER: ${{ matrix.issue }}
    steps:
<<react_eyes('issues/' ~ issue)>>

<<checkout(cfg, ref=cfg.default_branch)>>
<<setup>>
<<agent_step(cfg, block_input('prompt', prompt))>>

<<unreact_eyes(cfg, 'issues/' ~ issue, if_condition='always()')>>
