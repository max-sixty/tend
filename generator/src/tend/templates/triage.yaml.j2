{%- set issue = '${{ matrix.issue }}' -%}
<<header>>
name: tend-triage
# Keep the selected IDs visible before matrix jobs exist.
run-name: triage ${{ inputs.issues || format('[{0}]', github.event.issue.number) }}
on:
  issues:
    types: [opened, reopened]
  workflow_dispatch:
    inputs:
      issues:
        description: JSON array of issue numbers; use the triage-batch dispatch command to split large selections
        type: string
        required: true

jobs:
  select:
    if: <<fork_guard_prefix(cfg)>><<tend_enabled>> && <<not_bookkeeping()>>
    runs-on: ubuntu-24.04
<<environment()>>
    permissions:
      contents: read
    outputs:
      legs: ${{ steps.select.outputs.legs }}
    steps:
<<setup_tend_runtime()>>
      - name: Select current issues
        id: select
        env:
          GITHUB_TOKEN: ${{ secrets.<<bot_token_secret>> }}
          ISSUES: ${{ inputs.issues || format('[{0}]', github.event.issue.number) }}
          BOOKKEEPING_LABELS: '<<bookkeeping_labels|tojson>>'
          LANES: <<lanes>>
        run: |
          tend runtime triage-batch select

  triage:
    needs: select
    if: needs.select.outputs.legs != '[]'
    name: "triage #${{ matrix.issue }}"
    strategy:
      fail-fast: false
      matrix:
        include: ${{ fromJSON(needs.select.outputs.legs) }}
    # Each issue job waits in lane `issue % <<lanes>>`, which runs one job at a
    # time, so at most <<lanes>> sessions run at once across event runs and
    # dispatched batches. An issue always takes the same lane, so two runs for
    # one issue never overlap. Lanes are fixed by issue number, so two issues in
    # one lane wait for each other even while another lane is idle. GitHub
    # cancels a job beyond a lane's 100 pending ones; its open issue stays for
    # the daily sweep.
    concurrency:
      group: tend-triage-${{ matrix.lane }}
      cancel-in-progress: false
      queue: max
    runs-on: ubuntu-24.04
<<environment()>>
    permissions:
<<permissions()>>
    env:
      TEND_ISSUE_NUMBER: ${{ matrix.issue }}
    steps:
<<setup_tend_runtime()>>
<<react_eyes('issues/' ~ issue)>>

<<checkout(cfg, ref=cfg.default_branch)>>
<<setup>>
<<agent_step(cfg, block_input('prompt', prompt))>>

<<unreact_eyes(cfg, 'issues/' ~ issue, if_condition='always()')>>
