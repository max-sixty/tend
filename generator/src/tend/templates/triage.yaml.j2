{%- set issue = '${{ github.event.issue.number || inputs.issue }}' -%}
<<header>>
name: tend-triage
# A dispatched run would otherwise be named for the workflow. Named for the
# issue, like an opened one, the notifications poll can see it holds that
# issue.
run-name: ${{ inputs.title || github.event.issue.title }}
on:
  issues:
    types: [opened, reopened]
  # An issue a later run hands back, such as a stalled CI report or cause.
  workflow_dispatch:
    inputs:
      issue:
        description: The issue to triage
        type: number
        required: true
      title:
        description: The issue's title, which names the run
        type: string
        default: ""

jobs:
  enqueue:
    if: <<fork_guard_prefix(cfg)>><<tend_enabled>> && <<not_bookkeeping()>>
    runs-on: ubuntu-24.04
<<environment()>>
    permissions: {}
    outputs:
      ready: ${{ steps.queue.outputs.ready }}
    steps:
      - name: Record pending triage before admission
        id: queue
        env:
          GH_TOKEN: ${{ secrets.<<bot_token_secret>> }}
          ISSUE_NUMBER: <<issue>>
          QUEUE_ACTION: enqueue
        run: |
          python3 -I - <<heredoc>>'TEND_PY'
<<queue_script|indent(10, first=True)>>
          TEND_PY

  triage:
    needs: enqueue
    if: <<fork_guard_prefix(cfg)>><<tend_enabled>> && needs.enqueue.outputs.ready == 'true'
    # One issue worker at a time, including report diagnosis and recovery.
    # The issue's pending label survives failure or GitHub's finite queue.
    concurrency:
      group: tend-triage
      cancel-in-progress: false
      queue: max
    runs-on: ubuntu-24.04
<<environment()>>
    permissions:
<<permissions()>>
    steps:
      - name: Recheck live issue after admission
        id: admit
        env:
          GH_TOKEN: ${{ secrets.<<bot_token_secret>> }}
          ISSUE_NUMBER: <<issue>>
          QUEUE_ACTION: admit
        run: |
          python3 -I - <<heredoc>>'TEND_PY'
<<queue_script|indent(10, first=True)>>
          TEND_PY

<<react_eyes('issues/' ~ issue, if_condition=ready_condition)>>

<<checkout(cfg, ref=cfg.default_branch, if_condition=ready_condition)>>
<<setup>>
<<agent_step(cfg, block_input('prompt', prompt), if_condition=ready_condition)>>

      - name: Complete pending triage
        if: success() && <<ready_condition>>
        env:
          GH_TOKEN: ${{ secrets.<<bot_token_secret>> }}
          ISSUE_NUMBER: <<issue>>
          QUEUE_ACTION: complete
          QUEUE_GENERATION: ${{ steps.admit.outputs.generation }}
        run: |
          python3 -I - <<heredoc>>'TEND_PY'
<<queue_script|indent(10, first=True)>>
          TEND_PY

<<unreact_eyes(cfg, 'issues/' ~ issue, if_condition='always() && ' ~ ready_condition)>>
